# Основные настройки приложения
APP_NAME=FinFlow
APP_VERSION=0.1.0
DEBUG=False

# База данных PostgreSQL (Supabase Pooler)
# PORT=6543 - Transaction Mode (для FastAPI и MCP)
# SESSION_PORT=5432 - Session Mode (для Alembic и pg_dump)
HOST=host
PORT=6543
SESSION_PORT=5432
DATABASE=postgres
USER=postgres
PASSWORD=your_password

